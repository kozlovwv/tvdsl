// gcd(48, 18) = 6. Euclid's algorithm, positive arguments.
gcd(a:int, b:int) requires a > 0 and b > 0 returns r:int uses x:int, y:int {
    x = a;
    y = b;
    while (x != y) {
        if (x > y) x = x - y;
        else y = y - x;
    }
    r = x;
}

// triangle(4) = 10. Nested loops, n >= 0.
triangle(n:int) returns r:int uses i:int, j:int {
    r = 0;
    i = 1;
    while (i <= n) {
        j = 0;
        while (j < i) {
            r = r + 1;
            j = j + 1;
        }
        i = i + 1;
    }
}
