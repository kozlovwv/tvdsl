// arraySum([2, -3, 7]) = 6; arraySum([]) = 0.
arraySum(a:int[]) returns r:int uses i:int {
    r = 0;
    i = 0;
    while (i < length(a)) {
        r = r + a[i];
        i = i + 1;
    }
}

// reversed([1, 2, 3]) = [3, 2, 1]. Input is preserved.
reversed(a:int[]) returns b:int[] uses i:int {
    b = a;
    i = 0;
    while (i < length(a)) {
        b[i] = a[length(a) - i - 1];
        i = i + 1;
    }
}
