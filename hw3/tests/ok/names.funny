// Names: forward calls and recursion, formulas calling formulas, quantifier variables,
// a local and a function with the same name (different namespaces).
main(n:int) requires n >= 0 returns r:int ensures r == twice(n) {
    r = twice(n);
}

twice(x:int) returns y:int {
    if (x == 0) y = 0; else y = twice(x - 1) + 2;
}

// 'k' is a local of 'search', but 'requires' does not see locals: the name is free there.
search(a:int[], v:int) requires forall (k:int | k < 0 or k >= 0) returns found:int
    uses k:int {
    found = 0;
    k = 0;
    while (k < length(a)) invariant 0 <= k and (found == 1 -> exists (j:int | in(a, j) and a[j] == v)) {
        if (a[k] == v) found = 1;
        k = k + 1;
    }
    twice = found;  // a local named like the function
}

in(a:int[], i:int) => 0 <= i and i < length(a);
sorted(a:int[]) => forall (i:int | in(a, i) and in(a, i + 1) -> a[i] <= a[i + 1]);
