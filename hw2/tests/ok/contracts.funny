// Formulas, quantifiers, formula references, requires / ensures / invariant / uses.
sorted(a:int[], l:int, r:int) =>
    forall (k:int | l <= k and k < r -> a[k] <= a[k + 1]);

nonneg(a:int[]) => forall (k:int | k >= 0 and k < length(a) -> a[k] >= 0)

has(a:int[], v:int) => exists (k:int | k >= 0 and a[k] == v);

sum(a:int[]) requires nonneg(a) and length(a) > 0 returns s:int ensures s >= 0 uses i:int, t {
    s = 0;
    i = 0;
    while (i < length(a))
        invariant 0 <= i and s >= 0 and forall (j:int | j < i -> exists (m:int | m == j))
    {
        s = s + a[i];
        i = i + 1;
    }
    assert sorted(a, 0, length(a) - 1) or not has(a, 0);
    assume true;
}
